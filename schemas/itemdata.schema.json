{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "buildwars item description schema",
	"type": "object",
	"required": [
		"itemdata"
	],
	"properties": {
		"itemdata": {
			"description": "item data root element",
			"type": "object",
			"patternProperties": {
				"^[0-9]+$": {
					"$ref": "#/$defs/data"
				}
			},
			"additionalProperties": false
		}
	},
	"$defs": {
		"data": {
			"description": "item data object, enumerated by item ID",
			"properties": {
				"id": {
					"description": "item ID",
					"type": "integer",
					"minimum": 0
				},
				"position": {
					"description": "item slot ID",
					"type": "integer",
					"minimum": 0,
					"maximum": 7
				},
				"type": {
					"description": "item type ID",
					"type": "integer",
					"minimum": 0
				},
				"profession": {
					"description": "profession ID",
					"type": ["integer", "null"],
					"minimum": 0,
					"maximum": 10
				},
				"attribute": {
					"description": "attribute ID",
					"type": ["integer", "null"],
					"minimum": -1
				},
				"dmg_type": {
					"description": "damage type ID",
					"type": ["integer", "null"],
					"minimum": 0
				},
				"lang": {
					"description": "item descriptions (enumerated by language)",
					"patternProperties": {
						"^[a-z]{2}$": {
							"$ref": "#/$defs/lang"
						}
					},
					"additionalProperties": false
				}
			},
			"required": [
				"id",
				"position",
				"type",
				"profession",
				"attribute",
				"dmg_type",
				"lang"
			]
		},
		"lang": {
			"description": "item description object",
			"type": "object",
			"properties": {
				"name": {
					"description": "item name",
					"type": "string"
				},
				"affix": {
					"description": "item affixes",
					"type": "array"
				}
			},
			"required": [
				"name",
				"affix"
			]
		}
	}
}
