{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "buildwars modifier description schema",
	"type": "object",
	"required": [
		"moddata"
	],
	"properties": {
		"moddata": {
			"description": "mod data root element",
			"type": "object",
			"patternProperties": {
				"^[0-9]+$": {
					"$ref": "#/$defs/data"
				}
			},
			"additionalProperties": false
		}
	},
	"$defs": {
		"data": {
			"description": "mod data object, enumerated by item ID",
			"properties": {
				"id": {
					"description": "mod ID",
					"type": "integer",
					"minimum": 0
				},
				"type": {
					"description": "mod type ID",
					"type": "integer",
					"minimum": 0
				},
				"subtype": {
					"description": "mod subtype ID",
					"type": "integer",
					"minimum": 0
				},
				"for": {
					"description": "item type ID this mod is for",
					"type": "integer",
					"minimum": 0
				},
				"profession": {
					"description": "profession ID",
					"type": ["integer", "null"],
					"minimum": 0,
					"maximum": 10
				},
				"attribute": {
					"description": "attribute ID",
					"type": ["integer", "null"],
					"minimum": -1
				},
				"icon": {
					"description": "icon ID",
					"type": "integer",
					"minimum": 0
				},
				"lang": {
					"description": "item descriptions (enumerated by language)",
					"patternProperties": {
						"^[a-z]{2}$": {
							"$ref": "#/$defs/lang"
						}
					},
					"additionalProperties": false
				}
			},
			"required": [
				"id",
				"type",
				"subtype",
				"for",
				"profession",
				"attribute",
				"icon",
				"lang"
			]
		},
		"lang": {
			"description": "item description object",
			"type": "object",
			"properties": {
				"name": {
					"description": "item name",
					"type": "string"
				},
				"affix": {
					"description": "item affixes",
					"type": "array"
				}
			},
			"required": [
				"name",
				"affix"
			]
		}
	}
}
